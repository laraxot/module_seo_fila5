{
    "name": "laraxot/module_seo_fila5",
    "description": "Modulo SEO per l'ottimizzazione dei contenuti",
    "homepage": "https://github.com/laraxot/module_seo_fila5",
    "license": "MIT",
    "authors": [
        {
            "name": "marco sottana",
            "email": "marco.sottana@gmail.com",
            "role": "Developer"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\Seo\\Providers\\SeoServiceProvider"
            ],
            "aliases": {

            }
        }
    },
    "autoload": {
        "psr-4": {
            "Modules\\Seo\\": "app/",
            "Modules\\Seo\\Database\\Factories\\": "database/factories/",
            "Modules\\Seo\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "require": {
        "php": "^8.3",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-queueable-action": "^2.17",
        "livewire/livewire": "^4.3"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "larastan/larastan": "*"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../Xot"
        },
        {
            "type": "path",
            "url": "../Tenant"
        },
        {
            "type": "path",
            "url": "../UI"
        }
    ],
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
